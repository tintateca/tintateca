---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us">
  <section class="min-h-screen text-gray-900 py-12 px-4">
    <div class="max-w-3xl mx-auto">
      
      <form class="bg-gray-100 p-8 rounded-xl shadow-md space-y-12">
        
        <h1 class="text-4xl font-bold mb-6 text-orange-600 text-center font-coming-soon-regular">
            Contact Us
        </h1>
        <p class="text-center mb-8 text-lg text-gray-600 font-coming-soon-regular">
            We'd love to hear from you! Please fill out the form below and we'll get back to you soon.
          </p>
        <div>
          <label class="block mb-2 text-sm font-semibold text-gray-700 font-coming-soon-regular">Name</label>
          <input type="text" name="name" class="w-full px-4 py-2 rounded-md border border-gray-300 focus:ring-2 focus:ring-orange-500 focus:outline-none font-coming-soon-regular" required />
        </div>

        <div>
          <label class="block mb-2 text-sm font-semibold text-gray-700 font-coming-soon-regular">Email</label>
          <input type="email" name="email" class="w-full px-4 py-2 rounded-md border border-gray-300 focus:ring-2 focus:ring-orange-500 focus:outline-none font-coming-soon-regular" required />
        </div>

        <div>
          <label class="block mb-2 text-sm font-semibold text-gray-700 font-coming-soon-regular">Message</label>
          <textarea name="message" rows="5" class="w-full px-4 py-2 rounded-md border border-gray-300 focus:ring-2 focus:ring-orange-500 focus:outline-none font-coming-soon-regular" required></textarea>
        </div>

        <div class="text-center">
          <button type="submit" class="bg-orange-600 text-white px-6 py-2 rounded-lg font-semibold hover:bg-orange-700 transition font-coming-soon-regular">
            Send Message
          </button>
        </div>
      </form>
    </div>
  </section>
</Layout>
